#include<vector>
#include<deque>
#include<iostream>
using namespace std;
void SW(int a[],int n,int k){
	vector<int> result;
	deque <int> deq;
	for(int i=0;i<k;i++){
		while(!deq.empty()&&a[deq.back()]<a[i])
		deq.pop_back();
		deq.push_back(i);
	}
	result.push_back(a[deq.front()]);
	for(int i=k;i<n;i++){
		if(i-k+1>deq.front())
			deq.pop_front();
		while(!deq.empty()&&a[deq.back()]<a[i])
			deq.pop_back();
		deq.push_back(i);
		result.push_back(a[deq.front()]);	
	}
	for(int i=0;i<result.size();i++)
		cout<<"result[i]"<<"";
}
int main(){
	cout<<"enter n";
	int a[100],n;
	cin>>n;
	cout<<"enter elements:";
	for(int i=0;i<n;i++)
		cin>>a[i];
    cout<<"size of window:";
    int k;
    cin>>k;
    SW(a,n,k);
    return 0;
}
