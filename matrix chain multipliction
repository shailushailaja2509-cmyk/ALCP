#include<iostream>
using namespace std;
int main(){
    int p[]={10,20,30,40};
    int n=3,dp[10][10]={0};
    for(int len=2;len<=n;len++){
        for(int i=1;i<=n-len+1;i++){
            int j=i+len-1;
            dp[i][j]=1000000;
            for(int k=i;k<j;k++){
                int cost=dp[i][k]+dp[k+1][j]
                    +p[i-1]*p[k]*p[j];
                if(cost<dp[i][j])
                    dp[i][j]=cost;
            }
        }
    }
    cout<<dp[1][n];
    return 0;
}
