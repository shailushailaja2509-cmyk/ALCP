#include<iostream>
#include<algorithm>
using namespace std;
int main(){
    int a[]={10,9,2,5,3,7,101,18};
    int n=8,dp[100],ans=1;
    for(int i=0;i<n;i++)
        dp[i]=1;
    for(int i=1;i<n;i++){
        for(int j=0;j<i;j++){
            if(a[i]>a[j])
                dp[i]=max(dp[i],dp[j]+1);
        }
        ans=max(ans,dp[i]);
    }

    cout<<ans;
    return 0;
}
