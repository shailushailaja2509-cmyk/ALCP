#include <iostream>
using namespace std;
void MinMax(int a[],int n){
int min=a[0],max=a[0];
for(int i=1;i<n;i++){
if(a[i]<min)
min=a[i];
if(a[i]>max)
max=a[i];
}
cout<<"Min="<<min<<endl;
cout<<"Max="<<max;
}
int main(){
int n;
cin>>n;
int a[n];
for(int i=0;i<n;i++)
cin>>a[i];
MinMax(a,n);
return 0;
}
