#include <iostream>
using namespace std;
int main() {
    int n, num, sum = 0;
    cout << "Enter how many numbers: ";
    cin >> n;
    for (int i = 0; i < n; i++) {
        cout << "Enter number: ";
        cin >> num;
        sum = sum + num;
    }
    float average = (float)sum / n;
    cout << "Sum = " << sum << endl;
    cout << "Average = " << average << endl;
    return 0;
}
